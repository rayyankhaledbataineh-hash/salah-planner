# Salah Planner configuration. Copy to `.env` for local runs.
# In the cloud these are set via Secret Manager (the GOOGLE_* values) and
# --set-env-vars (location), NOT from this file.

# --- OAuth credentials (CLOUD ONLY) ---
# Locally these come from credentials.json + token.json instead, so you can
# leave them blank for local development.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- File paths (LOCAL ONLY) ---
# Override where the OAuth files live. Defaults shown.
# GOOGLE_CREDENTIALS_PATH=./credentials.json
# GOOGLE_TOKEN_PATH=./token.json

# --- Location ---
# In the CLOUD, location comes from the committed location.json, which the phone
# Shortcut updates whenever you move — nothing needs to be set here.
# LOCALLY, location is resolved in this order:
#   1. LATITUDE / LONGITUDE below (explicit override — handy behind a VPN)
#   2. location.json (if present)
#   3. IP geolocation (the default)
# So these are optional locally. Example below is Houston, TX.
# LATITUDE=29.7604
# LONGITUDE=-95.3698
# TIMEZONE=America/Chicago

# --- Scheduling ---
# How many days ahead to keep prayer events topped up.
DAYS_AHEAD=3
